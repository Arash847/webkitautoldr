+/* --- WebKit Autoloader integration (patches/relapse-autoload.patch) -------
+ *
+ * ?autoload=<name> replaces the stock "press R2 for kstuff / shadowmountplus /
+ * etaHEN" step: once the kernel chain has brought elfldr up on port 9021, send
+ * the named payload to it and report the outcome to the parent page. The
+ * parent (app.js) mirrors this log and shows the result.
+ *
+ * AUTOLOAD_BASE is relative to this page, so the iframe the autoloader arms at
+ * <app>/relapse/index.html resolves it to <app>/payloads/<name>. */
+const AUTOLOAD = new URLSearchParams(window.location.search).get("autoload");
+const AUTOLOAD_BASE = "../payloads/";
+
+function reportAutoload(ok, extra) {
+  window.parent.postMessage(
+    Object.assign({ type: "wkal", kind: "autoload", ok: ok }, extra || {}),
+    "*",
+  );
+}
+
+async function startAutoload(p, chain) {
+  const { loadAutoloadPayload } = await import("./kexp.js");
+  try {
+    const bytes = await loadAutoloadPayload(
+      p, chain, AUTOLOAD, AUTOLOAD_BASE, (message) => log(message, "info"));
+    log("autoload complete: " + bytes + " bytes sent to elfldr", "success");
+    reportAutoload(true, { bytes: bytes });
+  } catch (error) {
+    const why = error instanceof Error ? error.message : String(error);
+    log("autoload failed: " + why, "error");
+    reportAutoload(false, { why: why });
+  }
+}
