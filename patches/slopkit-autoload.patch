+        const recordSize = 0x3c0;
+        const records = mem(recordSize * count);
+        records.u8.fill(0);
+        const listResult = await sys(SYS_NETGETIFLIST, records.ptr, count);
+        if (listResult.failed)
+            throw payloadSyscallError("netgetiflist records", listResult);
+        for (let i = 0; i < count; ++i) {
+            const base = i * recordSize;
+            const octets = [records.u8[base + 40], records.u8[base + 41],
+                records.u8[base + 42], records.u8[base + 43]];
+            const ip = octets.join(".");
+            if (ip === "0.0.0.0" || ip === "127.0.0.1") continue;
+            let name = "";
